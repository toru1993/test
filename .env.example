# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-client-id-here

# 通知を送る対象のサーバー(ギルド)ID
GUILD_ID=your-server-id-here

# /notify でチャンネル指定を省略した場合に使うデフォルトの通知先チャンネルID
DEFAULT_NOTIFY_CHANNEL_ID=your-default-channel-id-here

# メンバー参加/退出などのイベント通知を送るチャンネルID(省略時は DEFAULT_NOTIFY_CHANNEL_ID を使用)
EVENT_NOTIFY_CHANNEL_ID=your-event-channel-id-here

# LINE Developers (https://developers.line.biz/console/) で取得したMessaging APIのチャンネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token-here

# 送信先のLINEユーザーID/グループID/ルームID (省略時のデフォルト送信先)
LINE_TARGET_ID=your-line-target-id-here

# LINEへの通知を控える「静かな時間帯」(24時間表記 HH:MM、日本時間)。日付をまたぐ指定も可能(例: 22:00〜07:00)。
# 両方設定した場合のみ有効。この時間帯の通知はすぐには送らずキュー(line-queue.json)に溜め、
# npm run flush-line-queue (タスクスケジューラで朝に実行) でまとめて送信します。未設定時は常に即時送信されます。
LINE_QUIET_HOURS_START=22:00
LINE_QUIET_HOURS_END=07:00

# Zoom Marketplace (https://marketplace.zoom.us/) で作成した Server-to-Server OAuth アプリの認証情報
ZOOM_ACCOUNT_ID=your-zoom-account-id-here
ZOOM_CLIENT_ID=your-zoom-client-id-here
ZOOM_CLIENT_SECRET=your-zoom-client-secret-here

# 録画を確認するZoomユーザーのログイン用メールアドレス
ZOOM_USER_ID=your-zoom-login-email-here

# 何日前までの録画をチェックするか(省略時は1日)
ZOOM_LOOKBACK_DAYS=1

# Google Cloud Console (https://console.cloud.google.com/) で作成したOAuthクライアント(デスクトップアプリ)の認証情報
GMAIL_CLIENT_ID=your-gmail-oauth-client-id-here
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret-here

# 要約メールの宛先(省略時は mqph0110.ts@gmail.com)
SUMMARY_RECIPIENT=mqph0110.ts@gmail.com

# Anthropic API キー (https://console.anthropic.com/) - 文字起こしの要約に使用
ANTHROPIC_API_KEY=your-anthropic-api-key-here
